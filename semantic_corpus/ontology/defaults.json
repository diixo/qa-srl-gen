{
  "_comment": [
    "Ontology v1 defaults. The handoff names this file defaults.yaml; it is JSON",
    "so that the package keeps its zero-dependency core (no PyYAML).",
    "",
    "'types' is a curated tree: each entry names its parent and any labels it adds",
    "beyond what it inherits. Inheritance through this tree is sound.",
    "",
    "'lexicon' maps surface words to CANDIDATE types. It only proposes. A word",
    "listed under one type is not thereby that type in a given sentence; words",
    "with several readings are listed with all of them on purpose."
  ],

  "types": {
    "place": { "parent": "LOCATION" },
    "city": { "parent": "place" },
    "town": { "parent": "place" },
    "village": { "parent": "place" },
    "country": { "parent": "place" },
    "region": { "parent": "place" },
    "building": { "parent": "place" },

    "creature": { "parent": "ANIMAL" },
    "dog": { "parent": "creature" },
    "cat": { "parent": "creature" },
    "horse": { "parent": "creature" },
    "bird": { "parent": "creature" },
    "big_cat": { "parent": "creature" },

    "human": { "parent": "PERSON" },
    "woman": { "parent": "human" },
    "man": { "parent": "human" },
    "child": { "parent": "human" },
    "profession": { "parent": "human" },

    "institution": { "parent": "ORGANIZATION" },
    "company": { "parent": "institution" },
    "university": { "parent": "institution" },
    "agency": { "parent": "institution" },

    "artifact": { "parent": "PHYSICAL_OBJECT" },
    "vehicle": { "parent": "artifact" },
    "car": { "parent": "vehicle" },
    "ship": { "parent": "vehicle" },
    "furniture": { "parent": "artifact" },
    "tool": { "parent": "artifact" },
    "toy": { "parent": "artifact" },
    "document": { "parent": "artifact" },

    "notion": { "parent": "ABSTRACT_ENTITY" },
    "feeling": { "parent": "notion", "labels": ["EMOTION"] },
    "event": { "parent": "notion" },

    "quality": { "parent": "PROPERTY" },
    "colour": { "parent": "quality" },
    "size": { "parent": "quality" },
    "condition": { "parent": "quality" },
    "affective_state": { "parent": "quality", "labels": ["STATE", "EMOTION"] }
  },

  "lexicon": {
    "city": ["city"],
    "town": ["town"],
    "village": ["village"],
    "country": ["country"],
    "region": ["region"],
    "house": ["building"],
    "gate": ["building"],

    "dog": ["dog"],
    "puppy": ["dog"],
    "shepherd": ["dog", "profession"],
    "cat": ["cat"],
    "horse": ["horse"],
    "bird": ["bird"],
    "jaguar": ["big_cat", "car"],

    "woman": ["woman"],
    "girl": ["woman", "child"],
    "man": ["man"],
    "boy": ["man", "child"],
    "child": ["child"],
    "mechanic": ["profession"],
    "teacher": ["profession"],
    "doctor": ["profession"],
    "driver": ["profession"],

    "company": ["company"],
    "university": ["university"],
    "agency": ["agency"],

    "car": ["car"],
    "ship": ["ship"],
    "boat": ["ship"],
    "ball": ["toy"],
    "book": ["document"],
    "letter": ["document"],
    "table": ["furniture"],
    "chair": ["furniture"],
    "hammer": ["tool"],

    "joy": ["feeling"],
    "fear": ["feeling"],
    "anger": ["feeling"],
    "sadness": ["feeling"],
    "surprise": ["feeling"],
    "idea": ["notion"],
    "plan": ["notion"],
    "freedom": ["notion"],
    "meeting": ["event"],
    "journey": ["event"],

    "red": ["colour"],
    "blue": ["colour"],
    "green": ["colour"],
    "tall": ["size"],
    "large": ["size"],
    "small": ["size"],
    "slender": ["size"],
    "broken": ["condition"],
    "old": ["condition"],
    "new": ["condition"],
    "beautiful": ["quality"],
    "afraid": ["affective_state"],
    "happy": ["affective_state"],
    "angry": ["affective_state"]
  }
}
